---
interface Props {
  size?: number;
}

const { size = 14 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 100 100" fill="none" aria-hidden="true">
  <g stroke="currentColor" stroke-width="11" stroke-linecap="round">
    <line x1="50" y1="10" x2="50" y2="90"></line>
    <line x1="15.4" y1="30" x2="84.6" y2="70"></line>
    <line x1="15.4" y1="70" x2="84.6" y2="30"></line>
  </g>
</svg>
