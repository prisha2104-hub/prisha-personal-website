---
import Base from '../layouts/Base.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Chain from '../components/Chain.astro';
import { moments } from '../data/chain';
---

<Base
  title="How one thing led to another"
  description="Markets, the reading, one regression study, a summer at an asset manager, a tab problem, UAA, and some calculus teaching — in causal order."
>
  <div class="wrap">
    <SectionIntro num="03" title="How one thing led to another">
      <p>It starts in Mumbai with the financial pages and, for now, ends at a whiteboard in New York.</p>
    </SectionIntro>

    <Chain moments={moments} />
  </div>
</Base>
