---
import Base from '../layouts/Base.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Chain from '../components/Chain.astro';
import { moments, futureThreads } from '../data/chain';
---

<Base
  title="How one thing led to another"
  description="Cause and effect, instead of a timeline. The chain of curiosities that keeps turning into projects."
>
  <div class="wrap">
    <SectionIntro num="03" title="How one thing led to another">
      <p>
        A résumé lists what happened and has surprisingly little to say about why. This is the
        why: the same life, told as a chain of causes rather than a list of dates. Follow the
        line.
      </p>
    </SectionIntro>

    <Chain moments={moments} />

    <section class="future-section">
      <p class="label">Other threads, still untangling</p>
      <ul>
        {
          futureThreads.map((t) => (
            <li>
              <span class="from">{t.from}</span>
              <span class="leader" aria-hidden="true" />
              <span class="to">{t.to}</span>
            </li>
          ))
        }
      </ul>
      <p class="future-note">
        These get drawn properly in a later phase. The connections are real; the ink isn’t dry.
      </p>
    </section>
  </div>
</Base>

<style>
  .future-section {
    margin-top: clamp(2rem, 6vh, 4rem);
    max-width: 38rem;
  }

  .future-section ul {
    margin-top: 1.5rem;
  }

  .future-section li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.85rem;
  }

  .from {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 460;
    flex-shrink: 0;
  }

  .leader {
    flex: 1;
    min-width: 2rem;
    border-bottom: 1px dotted var(--line);
    transform: translateY(-0.3em);
  }

  .to {
    font-style: italic;
    color: var(--ink-secondary);
    font-size: var(--text-small);
    text-align: right;
    max-width: 55%;
    line-height: 1.45;
  }

  .future-note {
    margin-top: 2.2rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }

  @media (max-width: 540px) {
    .future-section li {
      flex-wrap: wrap;
      row-gap: 0.15rem;
    }

    .leader {
      display: none;
    }

    .to {
      flex-basis: 100%;
      text-align: left;
      max-width: none;
    }
  }
</style>
