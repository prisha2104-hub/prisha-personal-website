---
import Base from '../layouts/Base.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Chain from '../components/Chain.astro';
import { moments } from '../data/chain';
---

<Base
  title="How one thing led to another"
  description="What led to what: markets, the reading, a research question, a summer at HDFC, and now Universal Asset Analyzer."
>
  <div class="wrap">
    <SectionIntro num="03" title="How one thing led to another">
      <p>What led to what, in order.</p>
    </SectionIntro>

    <Chain moments={moments} />
  </div>
</Base>
