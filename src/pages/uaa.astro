---
import Base from '../layouts/Base.astro';
import Scaffold from '../components/Scaffold.astro';
---

<Base
  title="Universal Asset Analyzer"
  description="Investment research, in one place. Built by two people who were tired of the alternative."
>
  <div class="wrap">
    <header class="intro">
      <p class="label">05 / 09 — <a class="crumb" href="/building">What I build</a></p>
      <h1>Universal Asset Analyzer</h1>
      <div class="lede prose">
        <p>
          Investment research, in one place. Started by two people who kept needing the same
          things from seventeen different tabs, and eventually took it personally.
        </p>
      </div>
    </header>

    <Scaffold
      heading="What this page will hold"
      items={[
        { name: 'The problem', hint: 'fragmented research, itemised without mercy' },
        { name: 'The product', hint: 'what it does, for whom, and what it refuses to do' },
        { name: 'The story', hint: 'how one thing led to another, continued' },
        { name: 'The deck', hint: 'for people who prefer their arguments in slides' },
      ]}
      note="Being written. The structure above is real; the content arrives in a later phase."
    />

    <p class="back">
      <a class="draw-link" href="/one-thing-led-to-another#uaa">← Back along the line</a>
    </p>
  </div>
</Base>

<style>
  .intro {
    padding-top: clamp(3.5rem, 9vh, 6.5rem);
  }

  .crumb {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  .crumb:hover,
  .crumb:focus-visible {
    color: var(--accent);
  }

  h1 {
    margin-top: 1.4rem;
    font-size: var(--text-h2);
    max-width: 22ch;
  }

  .lede {
    margin-top: 1.8rem;
    font-size: var(--text-lede);
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  .back {
    margin-top: clamp(3rem, 8vh, 5rem);
  }

  .back a {
    color: var(--ink-secondary);
  }
</style>
