---
import Base from '../layouts/Base.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Scaffold from '../components/Scaffold.astro';
---

<Base title="Elsewhere" description="Books, rabbit holes, and other off-résumé material.">
  <div class="wrap">
    <SectionIntro num="07" title="Elsewhere">
      <p>The parts of a person that don’t survive conversion to PDF.</p>
    </SectionIntro>
    <Scaffold
      items={[
        { name: 'Books', hint: 'read, abandoned, re-read' },
        { name: 'Articles', hint: 'the ones worth sending to people' },
        { name: 'Rabbit holes', hint: 'entered knowingly' },
        { name: 'Puzzles', hint: 'and other productive procrastination' },
      ]}
      note="Being written. The structure above is real; the content arrives in a later phase."
    />
  </div>
</Base>
