---
import Base from '../layouts/Base.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Scaffold from '../components/Scaffold.astro';
---

<Base title="Things I’m trying to understand" description="An honest list of open questions.">
  <div class="wrap">
    <SectionIntro num="06" title="Things I’m trying to understand">
      <p>An honest list. Some of these have been resisting for years.</p>
    </SectionIntro>
    <Scaffold
      items={[
        { name: 'Mathematics', hint: 'the parts that stop being about numbers' },
        { name: 'Markets', hint: 'why prices move, and why the explanations only arrive afterward' },
        { name: 'Technical ideas', hint: 'explained interactively, once I can explain them at all' },
        { name: 'Open questions', hint: 'kept open on purpose' },
      ]}
      note="Being written. The structure above is real; the content arrives in a later phase."
    />
  </div>
</Base>
