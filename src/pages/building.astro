---
import Base from '../layouts/Base.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Scaffold from '../components/Scaffold.astro';
---

<Base title="What I build" description="Currently: Universal Asset Analyzer, and this site.">
  <div class="wrap">
    <SectionIntro num="05" title="What I build">
      <p>Two things at the moment: UAA, and the site you’re reading.</p>
    </SectionIntro>
    <Scaffold
      items={[
        {
          name: 'Universal Asset Analyzer',
          hint: 'investment research, in one place · in progress',
          href: '/uaa',
        },
        { name: 'This site', hint: 'Astro, TypeScript, hand-set interactions' },
      ]}
      note="Proper write-ups, with decisions and dead ends, arrive in a later phase."
    />
  </div>
</Base>
