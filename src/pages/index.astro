---
import Base from '../layouts/Base.astro';
import Note from '../components/Note.astro';
import IndexList from '../components/IndexList.astro';
---

<Base home>
  <section class="intro wrap">
    <p class="label">01 / 08</p>
    <h1>Prisha Agarwal</h1>
    <div class="prose copy">
      <p>
        I study economics and mathematics at Barnard College in New York, and TA Calculus III for
        the Columbia math department.
      </p>
      <p>
        <Note id="note-markets" note="The financial kind, mostly. I’m told there are other kinds.">Markets</Note>{' '}have
        been the constant since high school in Mumbai: an independent study on whether investors
        anchor to old prices, a research summer at HDFC Asset Management, and now Universal Asset
        Analyzer — software I’m building with a friend to fit filings, screeners, models and notes
        into one window.
      </p>
      <p>
        The sequence connecting those is drawn — literally — at{' '}
        <a href="/one-thing-led-to-another">one thing led to another</a>. If you only came to
        verify employment, <a href="/conventional">the conventional version</a> is one page and
        very well behaved.
      </p>
    </div>
  </section>

  <section class="wrap index-section">
    <IndexList />
    <p class="furnishing">Parts of this place are still being furnished. The load-bearing walls are up.</p>
  </section>
</Base>

<style>
  .intro {
    padding-top: clamp(4rem, 12vh, 8rem);
  }

  h1 {
    margin-top: 1.6rem;
    font-size: var(--text-h1);
  }

  .copy {
    margin-top: clamp(2rem, 5vh, 3rem);
    font-size: clamp(1.125rem, 1.05rem + 0.45vw, 1.3125rem);
    line-height: 1.6;
  }

  .copy p + p {
    margin-top: 1.25em;
  }

  .index-section {
    margin-top: clamp(4.5rem, 11vh, 7.5rem);
  }

  .furnishing {
    margin-top: 2.4rem;
    font-style: italic;
    color: var(--ink-faint);
    font-size: var(--text-small);
  }
</style>
