---
import Base from '../layouts/Base.astro';
import Trail from '../components/Trail.astro';
import { courses, ending } from '../data/trail';
---

<Base
  title="The academic trail"
  description="A selection of the coursework behind what I’m studying now."
>
  <div class="wrap">
    <header class="intro">
      <p class="label">04 / 07 — <a class="crumb" href="/now">Now</a></p>
      <h1>The academic trail</h1>
      <div class="lede prose">
        <p>A selection of the coursework that shaped what I’m studying now.</p>
      </div>
    </header>

    <Trail courses={courses} ending={ending} />
  </div>
</Base>

<style>
  .intro {
    padding-top: clamp(3.5rem, 9vh, 6.5rem);
  }

  .crumb {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  .crumb:hover,
  .crumb:focus-visible {
    color: var(--accent);
  }

  h1 {
    margin-top: 1.4rem;
    font-size: var(--text-h2);
    max-width: 22ch;
  }

  .lede {
    margin-top: 1.8rem;
    font-size: var(--text-lede);
    line-height: 1.5;
    color: var(--ink-secondary);
  }
</style>
