---
import Base from '../layouts/Base.astro';
import Dossier from '../components/Dossier.astro';
import { identity, contacts, sections, skills, footnote } from '../data/conventional';
---

<Base
  title="The conventional version"
  description="The professional account: education, experience, building, skills. Accurate; not the whole story."
>
  <Dossier
    identity={identity}
    contacts={contacts}
    sections={sections}
    skills={skills}
    footnote={footnote}
  />
</Base>
